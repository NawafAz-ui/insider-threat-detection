# Set these in your shell before starting the API / engine (see README)
MONGO_URI=mongodb://localhost:27017
DB_NAME=insider_threat
JWT_SECRET=replace-with-a-long-random-string
JWT_MINUTES=30
CORS_ORIGINS=http://localhost:5173
REQUIRE_HTTPS=0
# Assistant: leave LLM_API_KEY empty to use the offline template answer
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional
PSEUDONYMIZE=0
PSEUDONYM_KEY=replace-me
# Separate database accounts (only with docker-compose.secure.yml)
# MONGO_URI_ENGINE=mongodb://itd_engine:...@localhost:27017/insider_threat
# MONGO_URI_API=mongodb://itd_api:...@localhost:27017/insider_threat
